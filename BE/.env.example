# BE 로컬 실행용 환경변수 예시. 이 파일을 BE/.env 로 복사해 값을 채운다. BE/.env는 git에 올리지 않는다.
# 형식: KEY=value (따옴표 없이). BE/ 에서 gradlew bootRun 하면 자동으로 읽는다.
# 주의: KEY= 처럼 값이 빈 줄은 "미설정"이 아니라 "빈 문자열"이다. 쓰지 않는 선택 항목은 줄째 주석(#)으로 둔다.

# --- DB (필수) ---
DB_PASSWORD=

# --- 토큰 (필수) ---
# access 토큰 서명 키. UTF-8 32바이트 이상의 난수. 만드는 법(둘 중 하나):
#   openssl rand -base64 48
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# --- Redis (refresh 토큰 보관) ---
# 로컬: docker run -d --name airdrum-redis -p 6379:6379 redis:7-alpine (비밀번호 없음)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 비밀번호를 쓰지 않으면 줄째 주석으로 둔다
# REDIS_PASSWORD=

# --- 소셜 로그인 ---
# 비워 두면 그 제공자만 비활성(로그인 요청 404)이고 앱은 기동한다.
# Google Cloud Console > 클라이언트(웹 애플리케이션). 리디렉션 URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SSAFY 포털 > 내 어플리케이션 > 서비스 설정 > SSAFY 로그인. 리다이렉트 URI: http://localhost:8080/api/auth/ssafy/callback
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=

# ADMIN으로 판정할 로그인 계정 이메일. 쉼표 구분, 대소문자 무시. 비우면 모두 USER.
ADMIN_EMAILS=

# --- 선택 (기본값을 바꿀 때만 주석을 풀고 값을 적는다) ---
# 로그인 후 돌아갈 FE 주소
# FRONTEND_BASE_URL=http://localhost:5173
# 콜백 URI 앞부분. 콘솔에 등록한 리다이렉트 URI와 맞아야 한다
# OAUTH_REDIRECT_BASE_URL=http://localhost:8080
# Safari로 로컬 테스트할 때만 false
# COOKIE_SECURE=true
# Redis 없이 실행할 때만: refresh 토큰을 메모리에 두고(재시작하면 로그인이 풀림) Redis 헬스 검사를 끈다
# REFRESH_TOKEN_STORE=memory
# MANAGEMENT_HEALTH_REDIS_ENABLED=false

# 내부 AI 워커 서비스 인증. 각 워커의 32바이트 이상 난수 토큰을 비밀로 전달한다.
# CHART_WORKER_CREDENTIALS=worker1=<난수>,worker2=<다른 난수>
# AUDIO_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:8333
# WORKER_STORAGE_URL_TTL=10m
# WORKER_STORAGE_ACCOMPANIMENT_WRITE_ACCESS_KEY=
# WORKER_STORAGE_ACCOMPANIMENT_WRITE_SECRET_KEY=

# MIDI 원본 전용 비공개·비버전 버킷을 확인한 경우에만 활성화한다.
# MIDI_STORAGE_ENABLED=true
# MIDI_STORAGE_ENDPOINT=http://127.0.0.1:8333
# MIDI_STORAGE_REGION=us-east-1
# MIDI_STORAGE_BUCKET=airdrum-midi-originals
# MIDI_STORAGE_ACCESS_KEY=
# MIDI_STORAGE_SECRET_KEY=
# MIDI_STORAGE_PRIVATE_BUCKET_CONFIRMED=true
