# 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용한다. .env는 저장소에 올리지 않는다.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
REDIS_PASSWORD=change-me

# 로그인 토큰 서명 키. UTF-8 32바이트 이상의 난수를 넣는다. 비워 두면 Compose가 실행을 멈춘다.
# 만드는 법: openssl rand -base64 48
# 운영에서 값을 바꾸면 발급된 access 토큰이 모두 무효가 되므로 배포마다 새로 만들지 않는다.
JWT_SECRET=

# 소셜 로그인. 콜백 주소는 {OAUTH_REDIRECT_BASE_URL}/api/auth/{google|ssafy}/callback 이다.
# 제공자 콘솔에 같은 주소를 등록해야 한다. https여야 로그인이 동작한다.
FRONTEND_BASE_URL=https://k15a307.p.ssafy.io
OAUTH_REDIRECT_BASE_URL=https://k15a307.p.ssafy.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
# 관리자 계정 이메일. 쉼표로 구분한다.
ADMIN_EMAILS=
# 가입 동의 허용 판(쉼표 구분). 비어 있으면 어떤 판이든 저장한다. 값을 넣으면 목록에 없는 판은 422로 거절한다.
# 판을 바꿀 때: ① 여기에 새 판을 추가(옛 판 유지)하고 api를 다시 만든다 ② FE 배포 ③ 옛 판을 뺀다. FE의 현재 판은 FE/src/domain/signupTerms.ts에 있다.
SIGNUP_CONSENT_TERMS_VERSIONS=
SIGNUP_CONSENT_PRIVACY_VERSIONS=
SIGNUP_CONSENT_DATA_VERSIONS=
SIGNUP_CONSENT_RECOMMENDATION_VERSIONS=

# 오브젝트 스토리지 접근 키. AWS S3가 아니라 이 서버 안에서 돌리는 SeaweedFS(S3 호환)의 접속 키이며, 서버에서 직접 만드는 값이다.
# 비워 두면 Compose가 실행을 멈춘다.
# 읽기용(reader)은 악보·반주 버킷 읽기만, 쓰기용(writer)은 서버 내부 적재·플레이 원본·임시 음원에 쓴다.
# 만드는 법: 접근 키 openssl rand -hex 10, 비밀 키 openssl rand -hex 24
OBJECT_STORAGE_READ_ACCESS_KEY=
OBJECT_STORAGE_READ_SECRET_KEY=
OBJECT_STORAGE_WRITE_ACCESS_KEY=
OBJECT_STORAGE_WRITE_SECRET_KEY=
# 브라우저가 서명 URL로 접속하는 공개 주소. 도메인 루트이며 경로 접두사를 붙이지 않는다.
# HTTPS 페이지에서 http 주소를 부르면 브라우저가 막으므로(혼합 콘텐츠) https 주소를 쓴다. SeaweedFS의 서명 검증 주소와 허용 출처(CORS)로도 쓰인다.
OBJECT_STORAGE_PUBLIC_URL=https://k15a307.p.ssafy.io
# 앱이 스토리지를 쓰도록 켜는 스위치. 서버 시험과 BE 확인을 마친 뒤 true로 바꾼다.
CHART_ASSET_ENABLED=false
PLAY_RAW_ENABLED=false

# Grafana(모니터링) 관리자 비밀번호. 비워 두면 Compose가 실행을 멈춘다. 서버에서 직접 만든 값을 쓴다.
# Grafana는 서버의 127.0.0.1:3000에만 열려 있고 SSH 터널로 접속한다.
GRAFANA_ADMIN_PASSWORD=

# 음원 원본 접수는 비공개·비버전 버킷 확인 후 활성화한다.
AUDIO_STORAGE_ENABLED=false
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_PRIVATE_BUCKET_CONFIRMED=false

# MIDI 원본 전용 버킷의 비공개·비버전 설정과 워커 계정 권한을 확인한 뒤 활성화한다.
MIDI_STORAGE_ENABLED=false
MIDI_STORAGE_PRIVATE_BUCKET_CONFIRMED=false
# 워커 전용 최소 권한 DB 및 저장소 계정. 실제 값은 서버 비밀 관리 경로에 둔다.
MIDI_WORKER_DB_USERNAME=
MIDI_WORKER_DB_PASSWORD=
MIDI_WORKER_STORAGE_ACCESS_KEY=
MIDI_WORKER_STORAGE_SECRET_KEY=

# 약점 분석 실측 보정 배치(coach-calibration)가 비식별 뷰를 읽는 읽기 전용 DB 계정(coach_export)의 비밀번호.
# 비워 두면 배치가 접속하기 전에 멈추고 실패 줄을 남긴다. 다른 서비스에는 영향이 없다. URL 안에 들어가므로 특수문자가 없는 hex로 만든다.
# 만드는 법: openssl rand -hex 24. 계정 생성은 BE가 뷰 마이그레이션을 서버에 적용한 뒤 서버에서 직접 한다(Infra/SECURITY.md).
COACH_EXPORT_PASSWORD=

# 곡 추천 R3. 기본은 모두 꺼짐이다. 켜는 절차는 README.md "곡 추천 R3 후보 배치".
# RECOMMEND_EXPORT_PASSWORD: 후보 배치가 뷰를 읽는 읽기 전용 DB 계정(recommend_export)의 비밀번호. URL에 들어가므로 openssl rand -hex 24로 만든다.
# RECOMMEND_BATCH_TOKEN: 배치가 BE에 적재할 때 쓰는 토큰. CHART_WORKER_CREDENTIALS에 recommend-batch=<같은 값>으로도 넣는다(32바이트 이상).
RECOMMEND_EXPORT_PASSWORD=
RECOMMEND_BATCH_TOKEN=
# 후보 배치 전체 시간 제한(초). 비우면 3600. 실데이터 실행 시간을 잰 뒤 조정한다. 동의 문구의 진행 중 배치 시한과 맞춘다.
# RECOMMEND_BATCH_TIMEOUT_SEC=
RECOMMEND_R3_ENABLED=false
RECOMMEND_R3_ROLLOUT_PERCENT=0
RECOMMEND_R3_ACCEPTED_MODEL_VERSIONS=

# 연주 중 LLM 구간 코칭(COACH-001). GPU 서버에서 `ssaplash-worker live-run`을 띄운 뒤 켠다. 판당·분당 요청 상한.
LIVE_COACH_LLM_ENABLED=false
# LIVE_COACH_LLM_PER_RUN=10
# LIVE_COACH_LLM_PER_MINUTE=6
# 습관 개인화: 사용자의 최근 리포트 약점으로 습관 요약을 붙인다. 문구 품질 개편이 운영에서 자리 잡은 뒤 켠다.
LIVE_COACH_HABIT_ENABLED=false

# AI 서버 주소. BE가 약점 구간 분석을 호출한다. 기본값(미설정)은 Compose 내부 주소라 보통 바꾸지 않는다.
# AI_ANALYSIS_BASE_URL=http://ai-api:8000

# FE 빌드 때 고정되는 값(FE/.env.example 참고). 비워 두면 FE 기본값(로그인 필수, 제공자 전체, 모니터 페이지 없음, 키보드 입력 켜짐).
# 센서가 오면 FE_VITE_KEYBOARD_INPUT=false로 빌드한다. 값을 바꾸면 web 이미지를 다시 빌드한다.
# FE_VITE_KEYBOARD_INPUT=
# FE_VITE_LOGIN_PROVIDERS=
# FE_VITE_MONITOR=
# 추천 학습 동의 화면. 문구와 SIGNUP_CONSENT_RECOMMENDATION_VERSIONS가 확정된 뒤에만 true로 한다. 비우면 꺼짐.
# FE_VITE_RECOMMENDATION_CONSENT_ENABLED=
# 실시간 코칭 거름. 실행 방식은 비움(끔)·json·onnx, 동작은 shadow(기록만, 기본)·on(지적을 뺌). 합성 데이터로 학습한 모델이라 on은 그림자 평가 뒤에 켠다.
# FE_VITE_COACH_GATE=
# FE_VITE_COACH_GATE_MODE=

# 내부 워커 인증. 형식은 workerId=토큰이며 쉼표로 여러 워커를 등록한다.
# 토큰은 서로 다른 32바이트 이상 난수여야 한다. 짧으면 BE가 시작하지 않고 비어 있으면 워커 API는 401이다.
# 실제 토큰은 공개·로그·저장소에 노출하지 않고 승인된 비밀 경로로 전달한다(SECURITY.md 15절).
# CHART_WORKER_CREDENTIALS=worker1=<32바이트 이상 난수>
# 서명 URL은 미설정 시 OBJECT_STORAGE_PUBLIC_URL을 사용한다. 외부 GPU에서 접근 가능한 공개 도메인을 쓴다.
# 음원 버킷은 비공개이고 버전 관리가 꺼져 있어야 한다(SECURITY.md 6.2, 15절).
# AUDIO_STORAGE_PUBLIC_ENDPOINT=https://k15a307.p.ssafy.io
