# 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용한다. .env는 저장소에 올리지 않는다.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
REDIS_PASSWORD=change-me

# 로그인 토큰 서명 키. UTF-8 32바이트 이상의 난수를 넣는다. 비워 두면 Compose가 실행을 멈춘다.
# 만드는 법: openssl rand -base64 48
# 운영에서 값을 바꾸면 발급된 access 토큰이 모두 무효가 되므로 배포마다 새로 만들지 않는다.
JWT_SECRET=

# 소셜 로그인. 콜백 주소는 {OAUTH_REDIRECT_BASE_URL}/api/auth/{google|ssafy}/callback 이다.
# 제공자 콘솔에 같은 주소를 등록해야 한다. 도메인·HTTPS 적용 전에는 로그인을 시험할 수 없다.
FRONTEND_BASE_URL=https://k15a307.p.ssafy.io
OAUTH_REDIRECT_BASE_URL=https://k15a307.p.ssafy.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
# 관리자 계정 이메일. 쉼표로 구분한다.
ADMIN_EMAILS=

# 오브젝트 스토리지 접근 키. AWS S3가 아니라 이 서버 안에서 돌리는 SeaweedFS(S3 호환)의 접속 키이며, 서버에서 직접 만드는 값이다.
# 비워 두면 Compose가 실행을 멈춘다.
# 읽기용(reader)은 악보·반주 버킷 읽기만, 쓰기용(writer)은 서버 내부 적재·플레이 원본·임시 음원에 쓴다.
# 만드는 법: 접근 키 openssl rand -hex 10, 비밀 키 openssl rand -hex 24
OBJECT_STORAGE_READ_ACCESS_KEY=
OBJECT_STORAGE_READ_SECRET_KEY=
OBJECT_STORAGE_WRITE_ACCESS_KEY=
OBJECT_STORAGE_WRITE_SECRET_KEY=
# 브라우저가 서명 URL로 접속하는 공개 주소. 도메인 루트이며 경로 접두사를 붙이지 않는다.
# HTTPS(S15P31A307-39) 적용 후에는 https 주소로 바꾼다.
OBJECT_STORAGE_PUBLIC_URL=http://k15a307.p.ssafy.io
# 앱이 스토리지를 쓰도록 켜는 스위치. 서버 시험과 BE 확인을 마친 뒤 true로 바꾼다.
CHART_ASSET_ENABLED=false
PLAY_RAW_ENABLED=false

# Grafana(모니터링) 관리자 비밀번호. 비워 두면 Compose가 실행을 멈춘다. 서버에서 직접 만든 값을 쓴다.
# Grafana는 서버의 127.0.0.1:3000에만 열려 있고 SSH 터널로 접속한다.
GRAFANA_ADMIN_PASSWORD=

# AI 서버 주소. BE가 약점 구간 분석을 호출한다. 기본값(미설정)은 Compose 내부 주소라 보통 바꾸지 않는다.
# AI_ANALYSIS_BASE_URL=http://ai-api:8000

# FE 빌드 때 고정되는 값(FE/.env.example 참고). 비워 두면 FE 기본값(로그인 필수, 제공자 전체, 모니터 페이지 없음, 키보드 입력 켜짐).
# 센서가 오면 FE_VITE_KEYBOARD_INPUT=false로 빌드한다. 값을 바꾸면 web 이미지를 다시 빌드한다.
# FE_VITE_KEYBOARD_INPUT=
# FE_VITE_LOGIN_PROVIDERS=
# FE_VITE_MONITOR=
