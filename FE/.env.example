# 키보드 임시 입력 (개발용). 스틱이 도착하면 false로 빌드해 키 매핑 카드와 키보드 소스 등록을 함께 끈다.
# 기본값(미설정)은 켜짐.
VITE_KEYBOARD_INPUT=true

# BE 주소. 개발 서버(npm run dev)가 /api 요청을 여기로 넘긴다. 빌드 결과에는 들어가지 않는다.
VITE_API_PROXY_TARGET=http://localhost:8080

# 로그인 검사. false면 BE 없이 모든 화면이 열린다(게임 화면만 개발할 때 .env.local에 둔다). 기본값(미설정)은 켜짐.
# VITE_AUTH_REQUIRED=false

# 로그인 버튼에 보일 제공자. 미설정이면 google,ssafy 전부. BE에 키가 없는 제공자는 뺀다 (예: google)
# VITE_LOGIN_PROVIDERS=google

# 곡 출처. builtin이면 BE 없이 내장 3곡 (기본 api)
# VITE_SONGS_SOURCE=builtin

# 개발용. 설정하면 모든 곡에 이 반주 URL을 쓴다(로컬 BE에 S3가 없을 때). 예: /dev-accompaniment.wav
# VITE_ACCOMPANIMENT_OVERRIDE=

# 스틱 패킷 모니터(/monitor/stick, EMB용). true일 때만 라우트가 등록된다. 운영 빌드는 미설정.
# VITE_MONITOR=true

# 미니게임 「정적 뒤 한 방」(이벤트용). 음원 폴더 주소를 주면 그 빌드에만 카드·경로가 생긴다. 운영 빌드는 미설정.
# 음원은 저장소에 없다. 로컬은 FE/public/event-audio/(git 제외)에 두고 아래 값을 /event-audio로 준다. 준비 방법은 README 「미니게임」 절.
# VITE_MINI_ONESHOT_AUDIO=/event-audio

# 추천 학습 신규 동의는 문구·BE 허용 판 확정 전 비활성(기본 false).
# VITE_RECOMMENDATION_CONSENT_ENABLED=false
# 실시간 코칭 거름. 실행 방식 off(비움)·json·onnx, 동작 shadow(기본)·on
# VITE_COACH_GATE=
# VITE_COACH_GATE_MODE=shadow
